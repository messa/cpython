"    for i in range(10):\n"
"        executor.submit(worker_process, queue, worker_configurer)"

#: ../../howto/logging-cookbook.rst:1553
msgid "Deploying Web applications using Gunicorn and uWSGI"
msgstr "Nasazování webových aplikací pomocí Gunicorn a uWSGI"

#: ../../howto/logging-cookbook.rst:1555
msgid ""
"When deploying Web applications using `Gunicorn <https://gunicorn.org/>`_ or"
" `uWSGI <https://uwsgi-docs.readthedocs.io/en/latest/>`_ (or similar), "
"multiple worker processes are created to handle client requests. In such "
"environments, avoid creating file-based handlers directly in your web "
"application. Instead, use a :class:`SocketHandler` to log from the web "
"application to a listener in a separate process. This can be set up using a "
"process management tool such as Supervisor - see `Running a logging socket "
"listener in production`_ for more details."
msgstr ""
"Při nasazování webových aplikací pomocí `Gunicorn <https://gunicorn.org/>`_ "
"nebo `uWSGI <https://uwsgi-docs.readthedocs.io/en/latest/>`_ (nebo "
"podobného), jsou vytvořeny více procesů workerů pro zpracování požadavků "
"klientů. V takových prostředích se vyhněte výtvorení handlerů založených na "
"souboru přímo ve vaší webové aplikaci. Místo toho použijte "
":class:`SocketHandler` k loggování z webové aplikace na listener v odděleném"
" procesu. To lze nastavit pomocí nástroje pro správu procesů, jako je "
"Supervisor - viz `Spuštění loggingového socket listeneru v produkci`_ pro "
"více podrobností."

#: ../../howto/logging-cookbook.rst:1565
msgid "Using file rotation"
msgstr "Použití rotace souborů"

#: ../../howto/logging-cookbook.rst:1570
msgid ""
"Sometimes you want to let a log file grow to a certain size, then open a new"
" file and log to that. You may want to keep a certain number of these files,"
" and when that many files have been created, rotate the files so that the "
"number of files and the size of the files both remain bounded. For this "
"usage pattern, the logging package provides a :class:`RotatingFileHandler`::"
msgstr ""
"Niekdy chcete, aby se soubor logu rozrostl na určitou velikost, pak otevřete"
" nový soubor a zaznamenávejte do něj. Můžete chtít ponechat určitý počet "
"těchto souborů, a pokud bude vytvořeno tolik souborů, rotujte soubory tak, "
"aby jak počet souborů, tak velikost souborů zůstaly omezené. Pro tento "
"způsob použití poskytuje balík logging :class:`RotatingFileHandler`::"

#: ../../howto/logging-cookbook.rst:1576
#, python-format
msgid ""
"import glob\n"
"import logging\n"
"import logging.handlers\n"
"\n"
"LOG_FILENAME = 'logging_rotatingfile_example.out'\n"
"\n"
"# Set up a specific logger with our desired output level\n"
"my_logger = logging.getLogger('MyLogger')\n"
"my_logger.setLevel(logging.DEBUG)\n"
"\n"
"# Add the log message handler to the logger\n"
"handler = logging.handlers.RotatingFileHandler(\n"
"              LOG_FILENAME, maxBytes=20, backupCount=5)\n"
"\n"
"my_logger.addHandler(handler)\n"
"\n"
"# Log some messages\n"
"for i in range(20):\n"
"    my_logger.debug('i = %d' % i)\n"
"\n"
"# See what files are created\n"
"logfiles = glob.glob('%s*' % LOG_FILENAME)\n"
"\n"
"for filename in logfiles:\n"
"    print(filename)"
msgstr ""
"import glob\n"
"import logging\n"
"import logging.handlers\n"
"\n"
"LOG_FILENAME = 'logging_rotatingfile_example.out'\n"
"\n"
"# Nastavte specišří logger s naším požadovaným výstupním stupněm\n"
"my_logger = logging.getLogger('MyLogger')\n"
"my_logger.setLevel(logging.DEBUG)\n"
"\n"
"# Přidejte obsluhující zpráv loggingu k loggeru\n"
"handler = logging.handlers.RotatingFileHandler(\n"
"              LOG_FILENAME, maxBytes=20, backupCount=5)\n"
"\n"
"my_logger.addHandler(handler)\n"
"\n"
"# Začárte některé zprávy\n"
"for i in range(20):\n"
"    my_logger.debug('i = %d' % i)\n"
"\n"
"# Podivejte se, jaké soubory byly vytvořeny\n"
"logfiles = glob.glob('%s*' % LOG_FILENAME)\n"
"\n"
"for filename in logfiles:\n"
"    print(filename)"

#: ../../howto/logging-cookbook.rst:1602
msgid ""
"The result should be 6 separate files, each with part of the log history for"
" the application:"
msgstr ""
"Výsledek by měl být 6 oddělených souborů, každý s částí historie logu "
"aplikace:"

#: ../../howto/logging-cookbook.rst:1605
msgid ""
"logging_rotatingfile_example.out\n"
"logging_rotatingfile_example.out.1\n"
"logging_rotatingfile_example.out.2\n"
"logging_rotatingfile_example.out.3\n"
"logging_rotatingfile_example.out.4\n"
"logging_rotatingfile_example.out.5"
msgstr ""
"logging_rotatingfile_example.out\n"
"logging_rotatingfile_example.out.1\n"
"logging_rotatingfile_example.out.2\n"
"logging_rotatingfile_example.out.3\n"
"logging_rotatingfile_example.out.4\n"
"logging_rotatingfile_example.out.5"

#: ../../howto/logging-cookbook.rst:1614
msgid ""
"The most current file is always :file:`logging_rotatingfile_example.out`, "
"and each time it reaches the size limit it is renamed with the suffix "
"``.1``. Each of the existing backup files is renamed to increment the suffix"
" (``.1`` becomes ``.2``, etc.)  and the ``.6`` file is erased."
msgstr ""
"Nejnovější soubor je vždy :file:`logging_rotatingfile_example.out` a "
"pokadité, kdy dosáhne limitu velikosti, je přejmenován s příponou ``.1``. "
"Každý z existujících zálohováných souborů je přejmenován tak, aby se zvýšila"
" přípona (``.1`` se stává ``.2``, atd.) a soubor ``.6`` je odstraňován."

#: ../../howto/logging-cookbook.rst:1619
msgid ""
"Obviously this example sets the log length much too small as an extreme "
"example.  You would want to set *maxBytes* to an appropriate value."
msgstr ""
"Zjevně tento příklad nastaví délku logu mnohem příliš malé jako extrémní "
"příklad. Chtěli byste nastavit *maxBytes* na vhodnou hodnotu."

#: ../../howto/logging-cookbook.rst:1627
msgid "Use of alternative formatting styles"
msgstr "Použití alternativních stylů formátování"

#: ../../howto/logging-cookbook.rst:1629
#, python-format
msgid ""
"When logging was added to the Python standard library, the only way of "
"formatting messages with variable content was to use the %-formatting "
"method. Since then, Python has gained two new formatting approaches: "
":class:`string.Template` (added in Python 2.4) and :meth:`str.format` (added"
" in Python 2.6)."
msgstr ""
"Když bylo loggování přidáno do standardní knihovny Python, jediným způsobem "
"formátování zpráv s proměnlivým obsahem bylo použití metody %-formátování. "
"Od té doby Python získal dva nové přístupy k formátování: "
":class:`string.Template` (přidáno v Pythonu 2.4) a :meth:`str.format` "
"(přidáno v Pythonu 2.6)."

#: ../../howto/logging-cookbook.rst:1635
msgid ""
"Logging (as of 3.2) provides improved support for these two additional "
"formatting styles. The :class:`Formatter` class been enhanced to take an "
"additional, optional keyword parameter named ``style``. This defaults to "
"``'%'``, but other possible values are ``'{'`` and ``'$'``, which correspond"
" to the other two formatting styles. Backwards compatibility is maintained "
"by default (as you would expect), but by explicitly specifying a style "
"parameter, you get the ability to specify format strings which work with "
":meth:`str.format` or :class:`string.Template`. Here's an example console "
"session to show the possibilities:"
msgstr ""
"Loggování (od verze 3.2) poskytuje zlepšenou podporu pro tyto dva další styl"
" formátování. Třída :class:`Formatter` byla rozšířena tak, aby přijala "
"další, volitelny parametr pojmenovaný ``style``. Ve výchozím nastavení je to"
" ``'%'``, ale další možné hodnoty jsou ``'{'`` a ``'$'``, které odpovídají "
"dalším dvěm formátováním stylů. Zpětná kompatibilita je ve výchozím "
"nastavení udržővána (jak byste očekovávali), ale explicitním zadáním "
"parametru style získáte schopnost zadávat formátovací řetězce, které pracují"
" s :meth:`str.format` nebo :class:`string.Template`. Zde je příklad sessions"
" konzole pro ukázání možností:"

#: ../../howto/logging-cookbook.rst:1645
msgid ""
">>> import logging\n"
">>> root = logging.getLogger()\n"
">>> root.setLevel(logging.DEBUG)\n"
">>> handler = logging.StreamHandler()\n"
">>> bf = logging.Formatter('{asctime} {name} {levelname:8s} {message}',\n"
"...                        style='{')\n"
">>> handler.setFormatter(bf)\n"
">>> root.addHandler(handler)\n"
">>> logger = logging.getLogger('foo.bar')\n"
">>> logger.debug('This is a DEBUG message')\n"
"2010-10-28 15:11:55,341 foo.bar DEBUG    This is a DEBUG message\n"
">>> logger.critical('This is a CRITICAL message')\n"
"2010-10-28 15:12:11,526 foo.bar CRITICAL This is a CRITICAL message\n"
">>> df = logging.Formatter('$asctime $name ${levelname} $message',\n"
"...                        style='$')\n"
">>> handler.setFormatter(df)\n"
">>> logger.debug('This is a DEBUG message')\n"
"2010-10-28 15:13:06,924 foo.bar DEBUG This is a DEBUG message\n"
">>> logger.critical('This is a CRITICAL message')\n"
"2010-10-28 15:13:11,494 foo.bar CRITICAL This is a CRITICAL message\n"
">>>"
msgstr ""
">>> import logging\n"
">>> root = logging.getLogger()\n"
">>> root.setLevel(logging.DEBUG)\n"
">>> handler = logging.StreamHandler()\n"
">>> bf = logging.Formatter('{asctime} {name} {levelname:8s} {message}',\n"
"...                        style='{')\n"
">>> handler.setFormatter(bf)\n"
">>> root.addHandler(handler)\n"
">>> logger = logging.getLogger('foo.bar')\n"
">>> logger.debug('Toto je zpráva DEBUG')\n"
"2010-10-28 15:11:55,341 foo.bar DEBUG    Toto je zpráva DEBUG\n"
">>> logger.critical('Toto je zpráva CRITICAL')\n"
"2010-10-28 15:12:11,526 foo.bar CRITICAL Toto je zpráva CRITICAL\n"
">>> df = logging.Formatter('$asctime $name ${levelname} $message',\n"
"...                        style='$')\n"
">>> handler.setFormatter(df)\n"
">>> logger.debug('Toto je zpráva DEBUG')\n"
"2010-10-28 15:13:06,924 foo.bar DEBUG Toto je zpráva DEBUG\n"
">>> logger.critical('Toto je zpráva CRITICAL')\n"
"2010-10-28 15:13:11,494 foo.bar CRITICAL Toto je zpráva CRITICAL\n"
">>>"

#: ../../howto/logging-cookbook.rst:1669
#, python-format
msgid ""
"Note that the formatting of logging messages for final output to logs is "
"completely independent of how an individual logging message is constructed. "
"That can still use %-formatting, as shown here::"
msgstr ""
"Všimněte si, že formátování zprovozněných zpráv na konečný výstup do logů je"
" zcela nezávislé na tom, jak je jednotlivá zpráva loggování postavena. To "
"stále může použít %-formátování, jak je ukázáno zde::"

#: ../../howto/logging-cookbook.rst:1673
#, python-format
msgid ""
">>> logger.error('This is an%s %s %s', 'other,', 'ERROR,', 'message')\n"
"2010-10-28 15:19:29,833 foo.bar ERROR This is another, ERROR, message\n"
">>>"
msgstr ""
">>> logger.error('Toto je další%s %s %s', 'chyba,', 'CHYBA,', 'zpráva')\n"
"2010-10-28 15:19:29,833 foo.bar ERROR Toto je další chyba, CHYBA, zpráva\n"
">>>"

#: ../../howto/logging-cookbook.rst:1677
#, python-format
msgid ""
"Logging calls (``logger.debug()``, ``logger.info()`` etc.) only take "
"positional parameters for the actual logging message itself, with keyword "
"parameters used only for determining options for how to handle the actual "
"logging call (e.g. the ``exc_info`` keyword parameter to indicate that "
"traceback information should be logged, or the ``extra`` keyword parameter "
"to indicate additional contextual information to be added to the log). So "
"you cannot directly make logging calls using :meth:`str.format` or "
":class:`string.Template` syntax, because internally the logging package uses"
" %-formatting to merge the format string and the variable arguments. There "
"would be no changing this while preserving backward compatibility, since all"
" logging calls which are out there in existing code will be using %-format "
"strings."
msgstr ""
"Loggingování volání (``logger.debug()``, ``logger.info()`` atd.) přijímají "
"pouze poziční parametry pro samotnou loggingovou zprávu, s klíčovými "
"parametry používanými pouze k určení voleb pro způsob zpracování aktuálního "
"loggingového volání (např. parametr ``exc_info`` k indikaci, že by měly být "
"zaznamenány informace o traceback, nebo parametr ``extra`` k indikaci "
"dodatkových kontextových informací, které má být přidáno do logu). Nemůžete "
"tedy přímo provést loggingování volání pomocí syntaxe :meth:`str.format` "
"nebo :class:`string.Template`, protože interně balík loggingu používá "
"%-formátování ke sjednocení formátovacího řetězce a proměnlivých argumentů. "
"Nebylo by změňování, zatímco by byla zachována zpětná kompatibilita, protože"
" všechna loggingování volání, které existují v existujícím kódu, budou "
"používat %-formátovací řetězce."

#: ../../howto/logging-cookbook.rst:1690
#, python-brace-format
msgid ""
"There is, however, a way that you can use {}- and $- formatting to construct"
" your individual log messages. Recall that for a message you can use an "
"arbitrary object as a message format string, and that the logging package "
"will call ``str()`` on that object to get the actual format string. Consider"
" the following two classes::"
msgstr ""
"Existuje však způsob, jak můžete použít {}- a $- formátování k vytváření "
"svých jednotlivých zprovozněných zpráv. Vzpomíněte si, že pro zprávu můžete "
"použít libovolný objekt jako formátovací řetězec zprávy a balík loggingu "
"zavolá ``str()`` na tomto objektu, aby získal aktuální formátovací řetězec. "
"Zvažte následující dvě třídy::"

#: ../../howto/logging-cookbook.rst:1696 ../../howto/logging-cookbook.rst:2784
msgid ""
"class BraceMessage:\n"
"    def __init__(self, fmt, /, *args, **kwargs):\n"
"        self.fmt = fmt\n"
"        self.args = args\n"
"        self.kwargs = kwargs\n"
"\n"
"    def __str__(self):\n"
"        return self.fmt.format(*self.args, **self.kwargs)\n"
"\n"
"class DollarMessage:\n"
"    def __init__(self, fmt, /, **kwargs):\n"
"        self.fmt = fmt\n"
"        self.kwargs = kwargs\n"
"\n"
"    def __str__(self):\n"
"        from string import Template\n"
"        return Template(self.fmt).substitute(**self.kwargs)"
msgstr ""
"class BraceMessage:\n"
"    def __init__(self, fmt, /, *args, **kwargs):\n"
"        self.fmt = fmt\n"
"        self.args = args\n"
"        self.kwargs = kwargs\n"
"\n"
"    def __str__(self):\n"
"        return self.fmt.format(*self.args, **self.kwargs)\n"
"\n"
"class DollarMessage:\n"
"    def __init__(self, fmt, /, **kwargs):\n"
"        self.fmt = fmt\n"
"        self.kwargs = kwargs\n"
"\n"
"    def __str__(self):\n"
"        from string import Template\n"
"        return Template(self.fmt).substitute(**self.kwargs)"

#: ../../howto/logging-cookbook.rst:1714
#, python-brace-format, python-format
msgid ""
"Either of these can be used in place of a format string, to allow {}- or "
"$-formatting to be used to build the actual \"message\" part which appears "
"in the formatted log output in place of \"%(message)s\" or \"{message}\" or "
"\"$message\". It's a little unwieldy to use the class names whenever you "
"want to log something, but it's quite palatable if you use an alias such as "
"__ (double underscore --- not to be confused with _, the single underscore "
"used as a synonym/alias for :func:`gettext.gettext` or its brethren)."
msgstr ""
"Jakékoliv z nich lze použít místo formátovacího řetězce, aby se povolilo "
"použití {}- nebo $-formátování k vytváření skutečné části \"zpráva\", která "
"se objeví v formátovaném logu na místě \"%(message)s\" nebo \"{message}\" "
"nebo \"$message\". Používání názvů tří d je trochu neuátsnost, ale je zcela "
"cíťavé pokud používáte alias, jako je __ (dvojité podtržení --- neměyj te to"
" zamatěovat s _, jedním podtržením používáným jako synonym/alias pro "
":func:`gettext.gettext` nebo její soubřažené)."

#: ../../howto/logging-cookbook.rst:1722
msgid ""
"The above classes are not included in Python, though they're easy enough to "
"copy and paste into your own code. They can be used as follows (assuming "
"that they're declared in a module called ``wherever``):"
msgstr ""
"Výše uvedené třídy nejsou zahrnuty v Pythonu, ačkoli se snadno zkoušejí "
"zkopírovat a vložit do svého kódu. Má je použít takto (za předpokladu, že "
"jsou deklarovány v modulu nazývaném ``wherever``):"

#: ../../howto/logging-cookbook.rst:1726
#, python-brace-format
msgid ""
">>> from wherever import BraceMessage as __\n"
">>> print(__('Message with {0} {name}', 2, name='placeholders'))\n"
"Message with 2 placeholders\n"
">>> class Point: pass\n"
"...\n"
">>> p = Point()\n"
">>> p.x = 0.5\n"
">>> p.y = 0.5\n"
">>> print(__('Message with coordinates: ({point.x:.2f}, {point.y:.2f})',\n"
"...       point=p))\n"
"Message with coordinates: (0.50, 0.50)\n"
">>> from wherever import DollarMessage as __\n"
">>> print(__('Message with $num $what', num=2, what='placeholders'))\n"
"Message with 2 placeholders\n"
">>>"
msgstr ""
">>> from wherever import BraceMessage as __\n"
">>> print(__('Zpráva s {0} {name}', 2, name='zástupnými symboly'))\n"
"Zpráva s 2 zástupnými symboly\n"
">>> class Point: pass\n"
"...\n"
">>> p = Point()\n"
">>> p.x = 0.5\n"
">>> p.y = 0.5\n"
">>> print(__('Zpráva se souřadnicemi: ({point.x:.2f}, {point.y:.2f})',\n"
"...       point=p))\n"
"Zpráva se souřadnicemi: (0.50, 0.50)\n"
">>> from wherever import DollarMessage as __\n"
">>> print(__('Zpráva s $num $what', num=2, what='zástupnými symboly'))\n"
"Zpráva s 2 zástupnými symboly\n"
">>>"

#: ../../howto/logging-cookbook.rst:1744
msgid ""
"While the above examples use ``print()`` to show how the formatting works, "
"you would of course use ``logger.debug()`` or similar to actually log using "
"this approach."
msgstr ""
"Ačkoli výše uvedené příklady používají ``print()`` k zobrazení, jak "
"formátování funguje, samozřejmě byste použili ``logger.debug()`` nebo "
"podobné pro skutečné loggování pomocí tohoto přístupu."

#: ../../howto/logging-cookbook.rst:1748
#, python-brace-format
msgid ""
"One thing to note is that you pay no significant performance penalty with "
"this approach: the actual formatting happens not when you make the logging "
"call, but when (and if) the logged message is actually about to be output to"
" a log by a handler. So the only slightly unusual thing which might trip you"
" up is that the parentheses go around the format string and the arguments, "
"not just the format string. That's because the __ notation is just syntax "
"sugar for a constructor call to one of the :samp:`{XXX}Message` classes."
msgstr ""
"Jedna věc na všimnutí je, že s tímto přísupem netrpíte významnými "
"penalizacemi výkonu: skutečné formátování se nestařá při volání loggingu, "
"ale když (a pokud) má být zaznamenaná zpráva skutečně výstupem do logu "
"handlerem. Proto je jediná trochu neužásná věc, která vás může zatrapólit, "
"to, že závorky jíst kolem formátovacího řetězce a argumentů, ne jen "
"formátovacího řetězce. To protože __ značení je jen syntaktický cukr pro "
"volání konstruktoru jedné z tří :samp:`{XXX}Message`."

#: ../../howto/logging-cookbook.rst:1756
msgid ""
"If you prefer, you can use a :class:`LoggerAdapter` to achieve a similar "
"effect to the above, as in the following example::"
msgstr ""
"Pokud chcete, můžete použít :class:`LoggerAdapter` k získání podobného "
"efektu jako výše, jak je vidět v následujícím příkladu::"

#: ../../howto/logging-cookbook.rst:1759
#, python-brace-format
msgid ""
"import logging\n"
"\n"
"class Message:\n"
"    def __init__(self, fmt, args):\n"
"        self.fmt = fmt\n"
"        self.args = args\n"
"\n"
"    def __str__(self):\n"
"        return self.fmt.format(*self.args)\n"
"\n"
"class StyleAdapter(logging.LoggerAdapter):\n"
"    def log(self, level, msg, /, *args, stacklevel=1, **kwargs):\n"
"        if self.isEnabledFor(level):\n"
"            msg, kwargs = self.process(msg, kwargs)\n"
"            self.logger.log(level, Message(msg, args), **kwargs,\n"
"                            stacklevel=stacklevel+1)\n"
"\n"
"logger = StyleAdapter(logging.getLogger(__name__))\n"
"\n"
"def main():\n"
"    logger.debug('Hello, {}', 'world!')\n"
"\n"
"if __name__ == '__main__':\n"
"    logging.basicConfig(level=logging.DEBUG)\n"
"    main()"
msgstr ""
"import logging\n"
"\n"
"class Message:\n"
"    def __init__(self, fmt, args):\n"
"        self.fmt = fmt\n"
"        self.args = args\n"
"\n"
"    def __str__(self):\n"
"        return self.fmt.format(*self.args)\n"
"\n"
"class StyleAdapter(logging.LoggerAdapter):\n"
"    def log(self, level, msg, /, *args, stacklevel=1, **kwargs):\n"
"        if self.isEnabledFor(level):\n"
"            msg, kwargs = self.process(msg, kwargs)\n"
"            self.logger.log(level, Message(msg, args), **kwargs,\n"
"                            stacklevel=stacklevel+1)\n"
"\n"
"logger = StyleAdapter(logging.getLogger(__name__))\n"
"\n"
"def main():\n"
"    logger.debug('Ahoj, {}', 'světě!')\n"
"\n"
"if __name__ == '__main__':\n"
"    logging.basicConfig(level=logging.DEBUG)\n"
"    main()"

#: ../../howto/logging-cookbook.rst:1785
msgid ""
"The above script should log the message ``Hello, world!`` when run with "
"Python 3.8 or later."
msgstr ""
"Výše uvedený skript by měl zaznamenat zprávu ``Ahoj, světě!`` při spuštění s"
" Pythonem 3.8 nebo nově jším."

#: ../../howto/logging-cookbook.rst:1794
msgid "Customizing ``LogRecord``"
msgstr "Přizpůsobení ``LogRecord``"

#: ../../howto/logging-cookbook.rst:1796
msgid ""
"Every logging event is represented by a :class:`LogRecord` instance. When an"
" event is logged and not filtered out by a logger's level, a "
":class:`LogRecord` is created, populated with information about the event "
"and then passed to the handlers for that logger (and its ancestors, up to "
"and including the logger where further propagation up the hierarchy is "
"disabled). Before Python 3.2, there were only two places where this creation"
" was done:"
msgstr ""
"Každá loggingování událost je reprezentována instance :class:`LogRecord`. "
"Když je událost zaznamenána a není filtrována úrovní loggerů, je vytvořen "
":class:`LogRecord`, vyplnen informacemi o události a poté předán handlerkům "
"pro danou logger (a její přédeků až do loggerů, kde je další šíření "
"hierarchie zakázáno). Před Pythonem 3.2 bylo jen dvou míst, kde bylo toto "
"vytváření prováděno:"

#: ../../howto/logging-cookbook.rst:1803
msgid ""
":meth:`Logger.makeRecord`, which is called in the normal process of logging "
"an event. This invoked :class:`LogRecord` directly to create an instance."
msgstr ""
":meth:`Logger.makeRecord`, která je volána v normálním procesu zaznamenávání"
" události. To vyvolalo :class:`LogRecord` přímo k vytvoření instance."

#: ../../howto/logging-cookbook.rst:1806
msgid ""
":func:`makeLogRecord`, which is called with a dictionary containing "
"attributes to be added to the LogRecord. This is typically invoked when a "
"suitable dictionary has been received over the network (e.g. in pickle form "
"via a :class:`~handlers.SocketHandler`, or in JSON form via an "
":class:`~handlers.HTTPHandler`)."
msgstr ""
":func:`makeLogRecord`, která je volána se slovníkem obsahujícím atributy, "
"které má být přidány k LogRecord. To je typicky vyvoleno, pokud byl vhodný "
"slovník přijat po síti (např. v podobě pickle skrz "
":class:`~handlers.SocketHandler` nebo v formátu JSON skrz "
":class:`~handlers.HTTPHandler`)."

#: ../../howto/logging-cookbook.rst:1812
msgid ""
"This has usually meant that if you need to do anything special with a "
":class:`LogRecord`, you've had to do one of the following."
msgstr ""
"Obvykle to znamenalo, že pokud musíte dělat néco zvláštního s "
":class:`LogRecord`, museli jste provést jednu z následujících."

#: ../../howto/logging-cookbook.rst:1815
msgid ""
"Create your own :class:`Logger` subclass, which overrides "
":meth:`Logger.makeRecord`, and set it using :func:`~logging.setLoggerClass` "
"before any loggers that you care about are instantiated."
msgstr ""
"Vytvořte své vlastní :class:`Logger` podměř ováné, které přepsalé "
":meth:`Logger.makeRecord` a nastavíte ji pomocí "
":func:`~logging.setLoggerClass` před tím, než se instantualizují jakékoliv "
"loggerů, na které se starate."

#: ../../howto/logging-cookbook.rst:1818
msgid ""
"Add a :class:`Filter` to a logger or handler, which does the necessary "
"special manipulation you need when its :meth:`~Filter.filter` method is "
"called."
msgstr ""
"Přidejte :class:`Filter` do loggerů nebo handleru, který provádí nezbytnou "
"speciální manipulaci, kterou potřebujete, když je volána jeho "
":meth:`~Filter.filter` metoda."

#: ../../howto/logging-cookbook.rst:1822
msgid ""
"The first approach would be a little unwieldy in the scenario where (say) "
"several different libraries wanted to do different things. Each would "
"attempt to set its own :class:`Logger` subclass, and the one which did this "
"last would win."
msgstr ""
"Přvín přístup by byl trochu neúzasaný ve scenáři, kde (například) několik "
"různých knihoven chtělo dělat různé věci. Každá by se pokusila nastavit své "
"vlastní :class:`Logger` podměřováné a ta, která by to udělala poslední, by "
"vyhrála."

#: ../../howto/logging-cookbook.rst:1827
msgid ""
"The second approach works reasonably well for many cases, but does not allow"
" you to e.g. use a specialized subclass of :class:`LogRecord`. Library "
"developers can set a suitable filter on their loggers, but they would have "
"to remember to do this every time they introduced a new logger (which they "
"would do simply by adding new packages or modules and doing ::"
msgstr ""
"Druhý přístup pracuje rozumně dobrě pro mnohé případy, ale není vám umožněo "
"například použít speciálizávanù podmäř podměřováné :class:`LogRecord`. "
"Vývojáři knihovny mohou nastavit vhodný filtr na své loggery, ale museli by "
"si pamatovat, aby to udělali pokadité, když zavedli nového loggerů (což by "
"udělali prostě přidáním nových balíků nebo modulů a dojědou dál ::"

#: ../../howto/logging-cookbook.rst:1833
msgid "logger = logging.getLogger(__name__)"
msgstr "logger = logging.getLogger(__name__)"

#: ../../howto/logging-cookbook.rst:1835
msgid ""
"at module level). It's probably one too many things to think about. "
"Developers could also add the filter to a :class:`~logging.NullHandler` "
"attached to their top-level logger, but this would not be invoked if an "
"application developer attached a handler to a lower-level library logger ---"
" so output from that handler would not reflect the intentions of the library"
" developer."
msgstr ""
"na úrovni modulu). Je to pravděpodobně jedno příliš mnoho věcí k "
"přemítšlení. Vývojáři by také mohli přidat filtr k "
":class:`~logging.NullHandler` připojenému k jejich loggerů na úrovni balíku,"
" ale nebude vyvolán, pokud vývojář aplikace připoji handler k loggerů na "
"nižší úrovni knihovny --- takže výstup z tohoto handleru by neodrážel úmysly"
" vývojáře knihovny."

#: ../../howto/logging-cookbook.rst:1841
msgid ""
"In Python 3.2 and later, :class:`~logging.LogRecord` creation is done "
"through a factory, which you can specify. The factory is just a callable you"
" can set with :func:`~logging.setLogRecordFactory`, and interrogate with "
":func:`~logging.getLogRecordFactory`. The factory is invoked with the same "
"signature as the :class:`~logging.LogRecord` constructor, as "
":class:`LogRecord` is the default setting for the factory."
msgstr ""
"V Pythonu 3.2 a nově jším se vytváření :class:`~logging.LogRecord` provádí "
"skrz ovádnu (factory), kterou můžete zadát. Ovádna je jen vyvolatelná, "
"kterou můžete nastavit pomocí :func:`~logging.setLogRecordFactory` a "
"dotazovat se pomocí :func:`~logging.getLogRecordFactory`. Ovádna je vyvolána"
" se stejným podpisem jako konstruktor :class:`~logging.LogRecord`, protože "
":class:`LogRecord` je výchozí nastavení pro ovádnu."

#: ../../howto/logging-cookbook.rst:1848
msgid ""
"This approach allows a custom factory to control all aspects of LogRecord "
"creation. For example, you could return a subclass, or just add some "
"additional attributes to the record once created, using a pattern similar to"
" this::"
msgstr ""
"Tento přístup umožňuje vlastní ovádněř kontrolovat všechny aspekty vytváření"
" LogRecord. Například byste mohli vrátit podměřováné, nebo jen přidat "
"některé další atributy k záznamu po vytvoření pomocí vzoru podobného "
"tomuto::"

#: ../../howto/logging-cookbook.rst:1852
msgid ""
"old_factory = logging.getLogRecordFactory()\n"
"\n"
"def record_factory(*args, **kwargs):\n"
"    record = old_factory(*args, **kwargs)\n"
"    record.custom_attribute = 0xdecafbad\n"
"    return record\n"
"\n"
"logging.setLogRecordFactory(record_factory)"
msgstr ""
"old_factory = logging.getLogRecordFactory()\n"
"\n"
"def record_factory(*args, **kwargs):\n"
"    record = old_factory(*args, **kwargs)\n"
"    record.custom_attribute = 0xdecafbad\n"
"    return record\n"
"\n"
"logging.setLogRecordFactory(record_factory)"

#: ../../howto/logging-cookbook.rst:1861
msgid ""
"This pattern allows different libraries to chain factories together, and as "
"long as they don't overwrite each other's attributes or unintentionally "
"overwrite the attributes provided as standard, there should be no surprises."
" However, it should be borne in mind that each link in the chain adds run-"
"time overhead to all logging operations, and the technique should only be "
"used when the use of a :class:`Filter` does not provide the desired result."
msgstr ""
"Tento vzor umožňuje různým knihovnám zetěhovat ovádny dohromady a pokud "
"nepřepíšou atributy jedné druhé nebo neúmyslně nepřépíšou atributy "
"poskytované jako standard, neměli byste mít žádné překvapení. Mělo by se "
"však mít na paměti, že každé odkaz v řetězci přidané spušťovací zátěž do "
"všech loggingových operací a tato technika by měla být použita jen v "
"případě, kdy použití :class:`Filter` neposkytne požadovaný výsledek."

#: ../../howto/logging-cookbook.rst:1873
msgid "Subclassing QueueHandler and QueueListener- a ZeroMQ example"
msgstr "Subměřování QueueHandler a QueueListener - příklad ZeroMQ"

#: ../../howto/logging-cookbook.rst:1876 ../../howto/logging-cookbook.rst:2009
msgid "Subclass ``QueueHandler``"
msgstr "Subměřování ``QueueHandler``"

#: ../../howto/logging-cookbook.rst:1878
msgid ""
"You can use a :class:`QueueHandler` subclass to send messages to other kinds"
" of queues, for example a ZeroMQ 'publish' socket. In the example below,the "
"socket is created separately and passed to the handler (as its 'queue')::"
msgstr ""
"Můžete použít :class:`QueueHandler` subměřované k odesílání zpráv do jiných "
"druhů front, například zásuvky ZeroMQ 'publish'. V příkladu níže je zásuvka "
"vytvořena samostatně a předána handleru (jako jeho 'fronta')::"

#: ../../howto/logging-cookbook.rst:1882
msgid ""
"import zmq   # using pyzmq, the Python binding for ZeroMQ\n"
"import json  # for serializing records portably\n"
"\n"
"ctx = zmq.Context()\n"
"sock = zmq.Socket(ctx, zmq.PUB)  # or zmq.PUSH, or other suitable value\n"
"sock.bind('tcp://*:5556')        # or wherever\n"
"\n"
"class ZeroMQSocketHandler(QueueHandler):\n"
"    def enqueue(self, record):\n"
"        self.queue.send_json(record.__dict__)\n"
"\n"
"\n"
"handler = ZeroMQSocketHandler(sock)"
msgstr ""
"import zmq   # používající pyzmq, Python vazbu pro ZeroMQ\n"
"import json  # pro sériové záznamy řádku\n"
"\n"
"ctx = zmq.Context()\n"
"sock = zmq.Socket(ctx, zmq.PUB)  # nebo zmq.PUSH, nebo jiná vhodná hodnota\n"
"sock.bind('tcp://*:5556')        # nebo kdekoli\n"
"\n"
"class ZeroMQSocketHandler(QueueHandler):\n"
"    def enqueue(self, record):\n"
"        self.queue.send_json(record.__dict__)\n"
"\n"
"\n"
"handler = ZeroMQSocketHandler(sock)"

#: ../../howto/logging-cookbook.rst:1897
msgid ""
"Of course there are other ways of organizing this, for example passing in "
"the data needed by the handler to create the socket::"
msgstr ""
"Samozřejmě existují další způsoby, jak to organizu, například předávání dat "
"potřebných pro handler k vytvoření zásuvky::"

#: ../../howto/logging-cookbook.rst:1900
msgid ""
"class ZeroMQSocketHandler(QueueHandler):\n"
"    def __init__(self, uri, socktype=zmq.PUB, ctx=None):\n"
"        self.ctx = ctx or zmq.Context()\n"
"        socket = zmq.Socket(self.ctx, socktype)\n"
"        socket.bind(uri)\n"
"        super().__init__(socket)\n"
"\n"
"    def enqueue(self, record):\n"
"        self.queue.send_json(record.__dict__)\n"
"\n"
"    def close(self):\n"
"        self.queue.close()"
msgstr ""
"class ZeroMQSocketHandler(QueueHandler):\n"
"    def __init__(self, uri, socktype=zmq.PUB, ctx=None):\n"
"        self.ctx = ctx or zmq.Context()\n"
"        socket = zmq.Socket(self.ctx, socktype)\n"
"        socket.bind(uri)\n"
"        super().__init__(socket)\n"
"\n"
"    def enqueue(self, record):\n"
"        self.queue.send_json(record.__dict__)\n"
"\n"
"    def close(self):\n"
"        self.queue.close()"

#: ../../howto/logging-cookbook.rst:1915 ../../howto/logging-cookbook.rst:1945
msgid "Subclass ``QueueListener``"
msgstr "Subměřování ``QueueListener``"

#: ../../howto/logging-cookbook.rst:1917
msgid ""
"You can also subclass :class:`QueueListener` to get messages from other "
"kinds of queues, for example a ZeroMQ 'subscribe' socket. Here's an "
"example::"
msgstr ""
"Můžete také subměřovat :class:`QueueListener` k příjetím zpráv z jiných "
"druhů front, například zásuvky ZeroMQ 'subscribe'. Zde je příklad::"

#: ../../howto/logging-cookbook.rst:1920
msgid ""
"class ZeroMQSocketListener(QueueListener):\n"
"    def __init__(self, uri, /, *handlers, **kwargs):\n"
"        self.ctx = kwargs.get('ctx') or zmq.Context()\n"
"        socket = zmq.Socket(self.ctx, zmq.SUB)\n"
"        socket.setsockopt_string(zmq.SUBSCRIBE, '')  # subscribe to everything\n"
"        socket.connect(uri)\n"
"        super().__init__(socket, *handlers, **kwargs)\n"
"\n"
"    def dequeue(self):\n"
"        msg = self.queue.recv_json()\n"
"        return logging.makeLogRecord(msg)"
msgstr ""
"class ZeroMQSocketListener(QueueListener):\n"
"    def __init__(self, uri, /, *handlers, **kwargs):\n"
"        self.ctx = kwargs.get('ctx') or zmq.Context()\n"
"        socket = zmq.Socket(self.ctx, zmq.SUB)\n"
"        socket.setsockopt_string(zmq.SUBSCRIBE, '')  # přihlášení k všemu\n"
"        socket.connect(uri)\n"
"        super().__init__(socket, *handlers, **kwargs)\n"
"\n"
"    def dequeue(self):\n"
"        msg = self.queue.recv_json()\n"
"        return logging.makeLogRecord(msg)"

#: ../../howto/logging-cookbook.rst:1935
msgid "Subclassing QueueHandler and QueueListener- a ``pynng`` example"
msgstr "Subměřování QueueHandler a QueueListener - příklad ``pynng``"

#: ../../howto/logging-cookbook.rst:1937
msgid ""
"In a similar way to the above section, we can implement a listener and "
"handler using :pypi:`pynng`, which is a Python binding to `NNG "
"<https://nng.nanomsg.org/>`_, billed as a spiritual successor to ZeroMQ. The"
" following snippets illustrate -- you can test them in an environment which "
"has ``pynng`` installed. Just for variety, we present the listener first."
msgstr ""
"Podobně jako výše uvedené kapitole můžeme implementovat listener a handler "
"pomocí :pypi:`pynng`, což je Python vazba na `NNG "
"<https://nng.nanomsg.org/>`_, propagovaná jako duchovní nástupce ZeroMQ. "
"Následující útorky ilustrují -- můžete je testovat v prostředí, které má "
"``pynng`` nainstalováno. Pouze pro rozmanitost jsme listener představili "
"nejdřív."

#: ../../howto/logging-cookbook.rst:1947
msgid ""
"# listener.py\n"
"import json\n"
"import logging\n"
"import logging.handlers\n"
"\n"
"import pynng\n"
"\n"
"DEFAULT_ADDR = \"tcp://localhost:13232\"\n"
"\n"
"interrupted = False\n"
"\n"
"class NNGSocketListener(logging.handlers.QueueListener):\n"
"\n"
"    def __init__(self, uri, /, *handlers, **kwargs):\n"
"        # Have a timeout for interruptability, and open a\n"
"        # subscriber socket\n"
"        socket = pynng.Sub0(listen=uri, recv_timeout=500)\n"
"        # The b'' subscription matches all topics\n"
"        topics = kwargs.pop('topics', None) or b''\n"
"        socket.subscribe(topics)\n"
"        # We treat the socket as a queue\n"
"        super().__init__(socket, *handlers, **kwargs)\n"
"\n"
"    def dequeue(self, block):\n"
"        data = None\n"
"        # Keep looping while not interrupted and no data received over the\n"
"        # socket\n"
"        while not interrupted:\n"
"            try:\n"
"                data = self.queue.recv(block=block)\n"
"                break\n"
"            except pynng.Timeout:\n"
"                pass\n"
"            except pynng.Closed:  # sometimes happens when you hit Ctrl-C\n"
"                break\n"
"        if data is None:\n"
"            return None\n"
"        # Get the logging event sent from a publisher\n"
"        event = json.loads(data.decode('utf-8'))\n"
"        return logging.makeLogRecord(event)\n"
"\n"
"    def enqueue_sentinel(self):\n"
"        # Not used in this implementation, as the socket isn't really a\n"
"        # queue\n"
"        pass\n"
"\n"
"logging.getLogger('pynng').propagate = False\n"
"listener = NNGSocketListener(DEFAULT_ADDR, logging.StreamHandler(), topics=b'')\n"
"listener.start()\n"
"print('Press Ctrl-C to stop.')\n"
"try:\n"
"    while True:\n"
"        pass\n"
"except KeyboardInterrupt:\n"
"    interrupted = True\n"
"finally:\n"
"    listener.stop()"
msgstr ""
"# listener.py\n"
"import json\n"
"import logging\n"
"import logging.handlers\n"
"\n"
"import pynng\n"
"\n"
"DEFAULT_ADDR = \"tcp://localhost:13232\"\n"
"\n"
"interrupted = False\n"
"\n"
"class NNGSocketListener(logging.handlers.QueueListener):\n"
"\n"
"    def __init__(self, uri, /, *handlers, **kwargs):\n"
"        # Mějte timeout pro přeruování a otevřete\n"
"        # zásuvku přihlášení\n"
"        socket = pynng.Sub0(listen=uri, recv_timeout=500)\n"
"        # Přihlášení b'' odpovídá všem tématům\n"
"        topics = kwargs.pop('topics', None) or b''\n"
"        socket.subscribe(topics)\n"
"        # Zachováváme zásuvku jako frontu\n"
"        super().__init__(socket, *handlers, **kwargs)\n"
"\n"
"    def dequeue(self, block):\n"
"        data = None\n"
"        # Dále smyčka, zatímco není přeruováno a není přijato žádné data přes\n"
"        # zásuvku\n"
"        while not interrupted:\n"
"            try:\n"
"                data = self.queue.recv(block=block)\n"
"                break\n"
"            except pynng.Timeout:\n"
"                pass\n"
"            except pynng.Closed:  # někdy se stane, když stisknete Ctrl-C\n"
"                break\n"
"        if data is None:\n"
"            return None\n"
"        # Získejte loggingovou událost odeslanou od publika\n"
"        event = json.loads(data.decode('utf-8'))\n"
"        return logging.makeLogRecord(event)\n"
"\n"
"    def enqueue_sentinel(self):\n"
"        # Není v této implementaci používáno, protože zásuvka opravdu není\n"
"        # fronta\n"
"        pass\n"
"\n"
"logging.getLogger('pynng').propagate = False\n"
"listener = NNGSocketListener(DEFAULT_ADDR, logging.StreamHandler(), topics=b'')\n"
"listener.start()\n"
"print('Stiskněte Ctrl-C pro zastavení.')\n"
"try:\n"
"    while True:\n"
"        pass\n"
"except KeyboardInterrupt:\n"
"    interrupted = True\n"
"finally:\n"
"    listener.stop()"

