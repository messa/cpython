" byt nastaveny."

#: ../../whatsnew/3.3.rst:1725
msgid "(Contributed by Richard Oudkerk in :issue:`14166`.)"
msgstr "(Prispel Richard Oudkerk v :issue:`14166`.)"

#: ../../whatsnew/3.3.rst:1729
msgid "pydoc"
