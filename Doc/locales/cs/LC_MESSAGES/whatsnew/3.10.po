"StrCache: TypeAlias = 'Cache[str]'  # a type alias\n"
"LOG_PREFIX = 'LOG[DEBUG]'  # a module constant"
msgstr ""
"StrCache: TypeAlias = 'Cache[str]'  # a type alias\n"
"LOG_PREFIX = 'LOG[DEBUG]'  # a module constant"

