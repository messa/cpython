msgid ""
">>> if rocket.position = event_horizon:\n"
"  File \"<stdin>\", line 1\n"
"    if rocket.position = event_horizon:\n"
"                       ^\n"
"SyntaxError: cannot assign to attribute here. Maybe you meant '==' instead of '='?"
msgstr ""
">>> if rocket.position = event_horizon:\n"
"  File \"<stdin>\", line 1\n"
"    if rocket.position = event_horizon:\n"
"                       ^\n"
"SyntaxError: cannot assign to attribute here. Maybe you meant '==' instead of '='?"

