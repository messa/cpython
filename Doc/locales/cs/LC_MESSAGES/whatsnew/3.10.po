#: ../../whatsnew/3.10.rst:295
msgid "(Contributed by Pablo Galindo in :issue:`43823`.)"
msgstr "(Přispěl Pablo Galindo v :issue:`43823`.)"

#: ../../whatsnew/3.10.rst:297
