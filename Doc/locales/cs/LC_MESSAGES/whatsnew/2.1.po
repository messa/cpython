#: ../../whatsnew/2.1.rst:3
msgid "What's New in Python 2.1"
msgstr "Co je nového v Pythonu 2.1"

#: ../../whatsnew/2.1.rst
msgid "Author"
msgstr "Autor"

#: ../../whatsnew/2.1.rst:5
