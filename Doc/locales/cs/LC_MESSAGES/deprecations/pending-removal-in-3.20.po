#: ../../deprecations/pending-removal-in-3.20.rst:2
msgid "Pending removal in Python 3.20"
msgstr "Bude odstraněno v Pythonu 3.20"

#: ../../deprecations/pending-removal-in-3.20.rst:4
msgid ""
"The ``__version__``, ``version`` and ``VERSION`` attributes have been "
"deprecated in these standard library modules and will be removed in Python "
"3.20. Use :py:data:`sys.version_info` instead."
msgstr ""
"Atributy ``__version__``, ``version`` a ``VERSION`` byly v těchto modulech "
"standardní knihovny označeny jako zastaralé a budou odstraněny v Pythonu "
"3.20. Místo nich použijte :py:data:`sys.version_info`."

