#: ../../library/dbm.rst:255
msgid ""
"``'f'``: Open the database in fast mode. Writes to the database will not be "
"synchronized."
msgstr ""
"``'f'``: Otevřete databázi v rychlém režimu. Zápisy do databáze nebudou "
"synchronizovány."

#: ../../library/dbm.rst:257
msgid ""
"``'s'``: Synchronized mode. Changes to the database will be written "
"immediately to the file."
msgstr ""
"``'s'``: Synchronizovaný režim. Změny v databázi budou okamžitě zapsány do "
