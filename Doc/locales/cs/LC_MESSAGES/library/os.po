#: ../../library/os.rst:2157
msgid ""
"This function can support :ref:`not following symlinks <follow_symlinks>`."
msgstr ""
"Tato funkce muze podporovat :ref:`nesledovani symlinku <follow_symlinks>`."

#: ../../library/os.rst:2159 ../../library/os.rst:2293
msgid ""
"Raises an :ref:`auditing event <auditing>` ``os.chflags`` with arguments "
"``path``, ``flags``."
msgstr ""
"Vyvola :ref:`auditni udalost <auditing>` ``os.chflags`` s argumenty "
"``path``, ``flags``."

#: ../../library/os.rst:2163
msgid "Added the *follow_symlinks* parameter."
msgstr "Pridan parametr *follow_symlinks*."

