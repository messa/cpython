#: ../../library/bdb.rst:102
msgid "``True`` if :class:`Breakpoint` is enabled."
msgstr "``True`` pokud je :class:`Breakpoint` povolen."

#: ../../library/bdb.rst:106
msgid "Numeric index for a single instance of a :class:`Breakpoint`."
msgstr "Numerický index pro jedinou instanci :class:`Breakpoint`."

#: ../../library/bdb.rst:110
msgid ""
"Dictionary of :class:`Breakpoint` instances indexed by (:attr:`file`, "
":attr:`line`) tuples."
msgstr ""
"Slovník instancí :class:`Breakpoint` indexovaný tuple (:attr:`file`, "
":attr:`line`)."

#: ../../library/bdb.rst:115
