#: ../../library/io.rst:311
msgid ":class:`IOBase`"
msgstr ":class:`IOBase`"

#: ../../library/io.rst:302
msgid "``fileno``, ``seek``, and ``truncate``"
msgstr "``fileno``, ``seek`` a ``truncate``"

#: ../../library/io.rst:302
msgid ""
"``close``, ``closed``, ``__enter__``, ``__exit__``, ``flush``, ``isatty``, "
"``__iter__``, ``__next__``, ``readable``, ``readline``, ``readlines``, "
"``seekable``, ``tell``, ``writable``, and ``writelines``"
msgstr ""
"``close``, ``closed``, ``__enter__``, ``__exit__``, ``flush``, ``isatty``, "
"``__iter__``, ``__next__``, ``readable``, ``readline``, ``readlines``, "
"``seekable``, ``tell``, ``writable`` a ``writelines``"

#: ../../library/io.rst:307
msgid ":class:`RawIOBase`"
msgstr ":class:`RawIOBase`"

#: ../../library/io.rst:307
msgid "``readinto`` and ``write``"
msgstr "``readinto`` a ``write``"

#: ../../library/io.rst:307
msgid "Inherited :class:`IOBase` methods, ``read``, and ``readall``"
msgstr "Zdeditene metody :class:`IOBase`, ``read`` a ``readall``"

#: ../../library/io.rst:309
msgid ":class:`BufferedIOBase`"
msgstr ":class:`BufferedIOBase`"

#: ../../library/io.rst:309
msgid "``detach``, ``read``, ``read1``, and ``write``"
msgstr "``detach``, ``read``, ``read1`` a ``write``"

#: ../../library/io.rst:309
msgid "Inherited :class:`IOBase` methods, ``readinto``, and ``readinto1``"
msgstr "Zdeditene metody :class:`IOBase`, ``readinto`` a ``readinto1``"

