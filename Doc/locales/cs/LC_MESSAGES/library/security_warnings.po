#: ../../library/security_warnings.rst:6
msgid "Security Considerations"
msgstr "Bezpečnostní aspekty"

#: ../../library/security_warnings.rst:8
msgid "The following modules have specific security considerations:"
msgstr "Následující moduly mají specifické bezpečnostní aspekty:"

#: ../../library/security_warnings.rst:10
msgid ""
":mod:`base64`: :ref:`base64 security considerations <base64-security>` in "
":rfc:`4648`"
msgstr ""
":mod:`base64`: :ref:`bezpečnostní aspekty base64 <base64-security>` v "
":rfc:`4648`"

#: ../../library/security_warnings.rst:12
msgid ""
":mod:`hashlib`: :ref:`all constructors take a \"usedforsecurity\" keyword-"
"only argument disabling known insecure and blocked algorithms <hashlib-"
"usedforsecurity>`"
msgstr ""
":mod:`hashlib`: :ref:`všechny konstruktory přijímají argument klíčového "
"slova \"usedforsecurity\", který zakazuje známé nejisté a zablokované "
"algoritmy <hashlib-usedforsecurity>`"

#: ../../library/security_warnings.rst:15
msgid ""
":mod:`http.server` is not suitable for production use, only implementing "
"basic security checks. See the :ref:`security considerations <http.server-"
"security>`."
msgstr ""
":mod:`http.server` není vhodný pro produkční použití, implementuje pouze "
"základní kontroly bezpečnosti. Viz :ref:`bezpečnostní aspekty <http.server-"
"security>`."

#: ../../library/security_warnings.rst:17
msgid ""
":mod:`logging`: :ref:`Logging configuration uses eval() <logging-eval-"
"security>`"
msgstr ""
":mod:`logging`: :ref:`konfigurace loggování používá eval() <logging-eval-"
"security>`"

#: ../../library/security_warnings.rst:19
msgid ""
":mod:`multiprocessing`: :ref:`Connection.recv() uses pickle "
"<multiprocessing-recv-pickle-security>`"
msgstr ""
":mod:`multiprocessing`: :ref:`Connection.recv() používá pickle "
"<multiprocessing-recv-pickle-security>`"

#: ../../library/security_warnings.rst:21
msgid ":mod:`pickle`: :ref:`Restricting globals in pickle <pickle-restrict>`"
msgstr ""
":mod:`pickle`: :ref:`omezení globálních proměnných v pickle <pickle-"
"restrict>`"

#: ../../library/security_warnings.rst:22
msgid ""
":mod:`random` shouldn't be used for security purposes, use :mod:`secrets` "
"instead"
msgstr ""
":mod:`random` se neměl používat pro bezpečnostní účely, místy použjíte "
":mod:`secrets`"

#: ../../library/security_warnings.rst:24
msgid ""
":mod:`shelve`: :ref:`shelve is based on pickle and thus unsuitable for "
"dealing with untrusted sources <shelve-security>`"
msgstr ""
":mod:`shelve`: :ref:`shelve je založen na pickle a tedy nevhodný pro práci s"
" nedūvěyhodnnými zdroji <shelve-security>`"

#: ../../library/security_warnings.rst:26
msgid ":mod:`ssl`: :ref:`SSL/TLS security considerations <ssl-security>`"
msgstr ":mod:`ssl`: :ref:`bezpečnostní aspekty SSL/TLS <ssl-security>`"

#: ../../library/security_warnings.rst:27
msgid ""
":mod:`subprocess`: :ref:`Subprocess security considerations <subprocess-"
"security>`"
msgstr ""
":mod:`subprocess`: :ref:`bezpečnostní aspekty subprocess <subprocess-"
"security>`"

#: ../../library/security_warnings.rst:29
msgid ""
":mod:`tempfile`: :ref:`mktemp is deprecated due to vulnerability to race "
"conditions <tempfile-mktemp-deprecated>`"
msgstr ""
":mod:`tempfile`: :ref:`mktemp je zastaralé kvůli zranitelnosti vûči race "
"conditions <tempfile-mktemp-deprecated>`"

#: ../../library/security_warnings.rst:31
msgid ":mod:`xml`: :ref:`XML security <xml-security>`"
msgstr ":mod:`xml`: :ref:`bezpečnost XML <xml-security>`"

#: ../../library/security_warnings.rst:32
msgid ""
":mod:`zipfile`: :ref:`maliciously prepared .zip files can cause disk volume "
"exhaustion <zipfile-resources-limitations>`"
msgstr ""
":mod:`zipfile`: :ref:`zlošmyslně připravenné .zip soubory mohou způsobit "
"vyčerpání kapacity disku <zipfile-resources-limitations>`"

#: ../../library/security_warnings.rst:35
msgid ""
"The :option:`-I` command line option can be used to run Python in isolated "
"mode. When it cannot be used, the :option:`-P` option or the "
":envvar:`PYTHONSAFEPATH` environment variable can be used to not prepend a "
"potentially unsafe path to :data:`sys.path` such as the current directory, "
"the script's directory or an empty string."
msgstr ""
"Volbu :option:`-I` v příkazovém řádku lze použít ke spuštění Pythonu v "
"izolovaném módu. Pokud ji nelze použít, lze použít volbu :option:`-P` nebo "
"proměnnou prostředí :envvar:`PYTHONSAFEPATH`, aby se :data:`sys.path` "
"neprepínálo potenciálně nebezpečné cesty, jako je aktuální adresář, adresář "
"skriptu nebo prázdný řetězec."

#: ../../library/security_warnings.rst:3
msgid "security considerations"
msgstr "bezpečnostní aspekty"
